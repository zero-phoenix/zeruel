diff --git a/tools/extract_template_formats.py b/tools/extract_template_formats.py
new file mode 100644
index 0000000..09e00a6
--- /dev/null
+++ b/tools/extract_template_formats.py
@@ -0,0 +1,149 @@
+"""Extract formatting profiles (no text) from the owner's private Word templates.
+
+Downloads each .docx into memory through the authenticated `gh` CLI, reads only formatting
+XML (page size, margins, paragraph alignment/spacing/indent, run font/size/bold/italic/underline,
+tables, header/footer presence) and writes aggregated statistics per category. Document text,
+file names, expediente numbers and author metadata are never read into the output.
+"""
+import collections
+import io
+import json
+import re
+import subprocess
+import sys
+import zipfile
+from pathlib import Path
+
+ROOT = Path(__file__).resolve().parents[1]
+OUT = ROOT / 'extension' / 'training' / 'format-profiles.json'
+W = '{http://schemas.openxmlformats.org/wordprocessingml/2006/main}'
+FONTS = ['Arial', 'Calibri', 'Times New Roman', 'Cambria', 'Verdana', 'Tahoma', 'Georgia', 'Courier New']
+SOURCES = {
+    'improcedencia_susalud': ('elaboracion-de-resoluciones-de-improcedencia-a-susalud', r'^plantillas_maestras/[^/]+\.docx$'),
+    'requerimiento': ('elaboracion-de-resoluciones-de-requerimiento', r'^plantillas_maestras/modelos_origen/.+\.docx$'),
+    'admisorio': ('SystemHope-ResAdmis', r'^plantillas_maestras/.+\.docx$'),
+    'cedula_r1': ('elaboracion-de-r1-de-expedientes-de-apelaciones-en-la-cc1-de-indecopi', r'^corpus/cedulas/.+\.docx$'),
+}
+LIMIT = 12  # per category; keeps the Celeron responsive
+
+
+def gh(*args, binary=False):
+    result = subprocess.run(['gh', *args], capture_output=True, check=True)
+    return result.stdout if binary else result.stdout.decode('utf8')
+
+
+def font_bucket(name):
+    if not name:
+        return 'unknown'
+    for font in FONTS:
+        if name.strip().lower() == font.lower():
+            return font
+    return 'other'
+
+
+def twips_to_cm(value):
+    return round(int(value) / 567, 2)
+
+
+def analyze(blob, stats):
+    from xml.etree import ElementTree as ET
+    z = zipfile.ZipFile(io.BytesIO(blob))
+    names = set(z.namelist())
+    doc = ET.fromstring(z.read('word/document.xml'))
+    defaults = {'font': None, 'size': None}
+    if 'word/styles.xml' in names:
+        styles = ET.fromstring(z.read('word/styles.xml'))
+        rpr = styles.find(f'{W}docDefaults/{W}rPrDefault/{W}rPr')
+        if rpr is not None:
+            fonts = rpr.find(f'{W}rFonts')
+            size = rpr.find(f'{W}sz')
+            defaults['font'] = fonts.get(f'{W}ascii') if fonts is not None else None
+            defaults['size'] = int(size.get(f'{W}val')) / 2 if size is not None else None
+    stats['documents'] += 1
+    stats['has_header'] += any(n.startswith('word/header') for n in names)
+    stats['has_footer'] += any(n.startswith('word/footer') for n in names)
+    stats['tables'].append(len(doc.findall(f'.//{W}tbl')))
+    for sect in doc.iter(f'{W}sectPr'):
+        size = sect.find(f'{W}pgSz')
+        margin = sect.find(f'{W}pgMar')
+        if size is not None:
+            stats['page_cm'][f"{twips_to_cm(size.get(f'{W}w'))}x{twips_to_cm(size.get(f'{W}h'))}"] += 1
+        if margin is not None:
+            key = '/'.join(str(twips_to_cm(margin.get(f'{W}{side}', 0))) for side in ('top', 'right', 'bottom', 'left'))
+            stats['margins_cm_trbl'][key] += 1
+    for p in doc.iter(f'{W}p'):
+        ppr = p.find(f'{W}pPr')
+        jc = ppr.find(f'{W}jc') if ppr is not None else None
+        stats['alignment'][(jc.get(f'{W}val') if jc is not None else 'left').replace('both', 'justify')] += 1
+        spacing = ppr.find(f'{W}spacing') if ppr is not None else None
+        if spacing is not None and spacing.get(f'{W}line'):
+            rule = spacing.get(f'{W}lineRule', 'auto')
+            value = int(spacing.get(f'{W}line'))
+            stats['line_spacing'][f'{round(value / 240, 2)}x' if rule == 'auto' else f'{round(value / 20, 1)}pt_{rule}'] += 1
+        if spacing is not None:
+            for side in ('before', 'after'):
+                if spacing.get(f'{W}{side}'):
+                    stats[f'space_{side}_pt'][round(int(spacing.get(f'{W}{side}')) / 20, 1)] += 1
+        ind = ppr.find(f'{W}ind') if ppr is not None else None
+        if ind is not None:
+            for attr in ('firstLine', 'left', 'hanging'):
+                if ind.get(f'{W}{attr}'):
+                    stats[f'indent_{attr}_cm'][twips_to_cm(ind.get(f'{W}{attr}'))] += 1
+        for r in p.iter(f'{W}r'):
+            if r.find(f'{W}t') is None:
+                continue
+            rpr = r.find(f'{W}rPr')
+            fonts = rpr.find(f'{W}rFonts') if rpr is not None else None
+            size = rpr.find(f'{W}sz') if rpr is not None else None
+            stats['font'][font_bucket(fonts.get(f'{W}ascii') if fonts is not None else defaults['font'])] += 1
+            stats['size_pt'][int(size.get(f'{W}val')) / 2 if size is not None else (defaults['size'] or 'default')] += 1
+            for tag, key in ((f'{W}b', 'bold'), (f'{W}i', 'italic'), (f'{W}u', 'underline')):
+                el = rpr.find(tag) if rpr is not None else None
+                stats[key] += el is not None and el.get(f'{W}val', 'true') not in ('0', 'false', 'none')
+            stats['runs'] += 1
+
+
+def new_stats():
+    s = collections.defaultdict(collections.Counter)
+    for key in ('documents', 'has_header', 'has_footer', 'runs', 'bold', 'italic', 'underline'):
+        s[key] = 0
+    s['tables'] = []
+    return s
+
+
+def finish(s):
+    out = {}
+    for key, value in s.items():
+        if isinstance(value, collections.Counter):
+            out[key] = {str(k): v for k, v in value.most_common(12)}
+        elif isinstance(value, list):
+            out[key] = {'min': min(value, default=0), 'max': max(value, default=0)}
+        else:
+            out[key] = value
+    return out
+
+
+def main():
+    profiles = {}
+    for category, (repo, pattern) in SOURCES.items():
+        branch = json.loads(gh('api', f'repos/zero-phoenix/{repo}'))['default_branch']
+        tree = json.loads(gh('api', f'repos/zero-phoenix/{repo}/git/trees/{branch}?recursive=1'))['tree']
+        paths = [t['path'] for t in tree if t['type'] == 'blob' and re.search(pattern, t['path'])][:LIMIT]
+        stats = new_stats()
+        for path in paths:
+            from urllib.parse import quote
+            blob = gh('api', '-H', 'Accept: application/vnd.github.raw', f'repos/zero-phoenix/{repo}/contents/{quote(path)}', binary=True)
+            try:
+                analyze(blob, stats)
+            except (zipfile.BadZipFile, KeyError):
+                stats['unreadable'] = stats.get('unreadable', 0) + 1
+            del blob
+        profiles[category] = finish(stats)
+        print(f'{category}: {stats["documents"]} documentos analizados')
+    OUT.parent.mkdir(exist_ok=True)
+    OUT.write_text(json.dumps({'schema': 1, 'content': 'format_only_no_text', 'profiles': profiles}, ensure_ascii=False, indent=2), encoding='utf8')
+    print(f'Perfil guardado: {OUT.relative_to(ROOT)}')
+
+
+if __name__ == '__main__':
+    sys.exit(main())
