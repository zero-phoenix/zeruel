diff --git a/extension/layout-from-ocr.js b/extension/layout-from-ocr.js
new file mode 100644
index 0000000..1abcaee
--- /dev/null
+++ b/extension/layout-from-ocr.js
@@ -0,0 +1,121 @@
+// Derives formatting metadata (size, alignment, geometry) from local OCR word boxes.
+// Input is geometry + the owner's transient OCR proposal; this module never stores text,
+// never emits recognized words, and never claims an exact reproduction. Font family, weight,
+// italic and underline cannot be read from OCR boxes alone, so they stay deliberately unknown
+// (font:'unknown', weight:400, italic/underline:false) rather than guessed. Output objects are
+// shaped to pass layout-model.validateLayout and carry no personal content.
+import {validateLayout} from './layout-model.js';
+
+const clampPx = value => Math.max(-10000, Math.min(10000, Math.round(value)));
+const median = numbers => {
+  const sorted = [...numbers].sort((a, b) => a - b);
+  if (!sorted.length) return 0;
+  const mid = Math.floor(sorted.length / 2);
+  return sorted.length % 2 ? sorted[mid] : (sorted[mid - 1] + sorted[mid]) / 2;
+};
+
+function box(node) {
+  const b = node && node.bbox;
+  if (!b || ![b.x0, b.y0, b.x1, b.y1].every(Number.isFinite) || b.x1 <= b.x0 || b.y1 <= b.y0) return null;
+  return {x0: b.x0, y0: b.y0, x1: b.x1, y1: b.y1};
+}
+
+// A line is a run of words sharing a baseline. We only keep its geometry, never its text.
+function linesFrom(ocr) {
+  if (Array.isArray(ocr?.lines)) {
+    return ocr.lines
+      .map(line => (Array.isArray(line?.words) ? line.words : []).map(box).filter(Boolean))
+      .filter(words => words.length)
+      .map(words => ({
+        x0: Math.min(...words.map(w => w.x0)), y0: Math.min(...words.map(w => w.y0)),
+        x1: Math.max(...words.map(w => w.x1)), y1: Math.max(...words.map(w => w.y1)),
+        heights: words.map(w => w.y1 - w.y0),
+      }));
+  }
+  // Fallback: a flat word list, grouped into lines by vertical overlap.
+  const words = (Array.isArray(ocr?.words) ? ocr.words : []).map(box).filter(Boolean)
+    .sort((a, b) => a.y0 - b.y0 || a.x0 - b.x0);
+  const lines = [];
+  for (const w of words) {
+    const mid = (w.y0 + w.y1) / 2;
+    const current = lines[lines.length - 1];
+    if (current && mid >= current.y0 && mid <= current.y1) {
+      current.x0 = Math.min(current.x0, w.x0); current.x1 = Math.max(current.x1, w.x1);
+      current.y0 = Math.min(current.y0, w.y0); current.y1 = Math.max(current.y1, w.y1);
+      current.heights.push(w.y1 - w.y0);
+    } else {
+      lines.push({x0: w.x0, y0: w.y0, x1: w.x1, y1: w.y1, heights: [w.y1 - w.y0]});
+    }
+  }
+  return lines;
+}
+
+// Blocks: consecutive lines whose vertical gap is small relative to their height.
+function blocksFrom(lines) {
+  const sorted = [...lines].sort((a, b) => a.y0 - b.y0);
+  const blocks = [];
+  let current = null;
+  for (const line of sorted) {
+    const h = median(line.heights) || (line.y1 - line.y0);
+    if (current && line.y0 - current.bottom <= h * 1.6) {
+      current.lines.push(line); current.bottom = Math.max(current.bottom, line.y1);
+    } else {
+      current = {lines: [line], bottom: line.y1}; blocks.push(current);
+    }
+  }
+  return blocks.map(b => b.lines);
+}
+
+function alignment(lines, pageWidthPx) {
+  if (lines.length < 2) return 'left';
+  const lefts = lines.map(l => l.x0), rights = lines.map(l => l.x1);
+  const spread = arr => Math.max(...arr) - Math.min(...arr);
+  const width = median(lines.map(l => l.x1 - l.x0)) || 1;
+  const tol = Math.max(6, width * 0.04);
+  const leftAligned = spread(lefts) <= tol;
+  const rightAligned = spread(rights) <= tol;
+  if (leftAligned && rightAligned) return 'justify';
+  if (rightAligned && !leftAligned) return 'right';
+  if (leftAligned) return 'left';
+  // Centered: each line's left and right margins (within the block span) are symmetric.
+  const blockLeft = Math.min(...lefts), blockRight = Math.max(...rights);
+  const centered = lines.every(l => Math.abs((l.x0 - blockLeft) - (blockRight - l.x1)) <= tol);
+  return centered ? 'center' : 'left';
+}
+
+function role(block, index, total, pageHeightPx, bodySizePx) {
+  const size = median(block.flatMap(l => l.heights));
+  const top = Math.min(...block.map(l => l.y0));
+  const bottom = Math.max(...block.map(l => l.y1));
+  if (index === 0 && pageHeightPx && top < pageHeightPx * 0.08) return 'header';
+  if (index === total - 1 && pageHeightPx && bottom > pageHeightPx * 0.9 && size <= bodySizePx) return 'footer';
+  if (size >= bodySizePx * 1.3) return 'heading';
+  return 'body';
+}
+
+export function layoutFromOcr(ocr, {pageWidthPx = 0, pageHeightPx = 0, page = 1} = {}) {
+  const lines = linesFrom(ocr);
+  const blocks = blocksFrom(lines);
+  if (!blocks.length) return [];
+  const bodySizePx = median(lines.flatMap(l => l.heights)) || 12;
+  return blocks.map((block, index) => {
+    const heights = block.flatMap(l => l.heights);
+    const fontSizePx = Math.max(1, clampPx(median(heights) || bodySizePx));
+    const tops = block.map(l => l.y0).sort((a, b) => a - b);
+    const gaps = tops.slice(1).map((y, i) => y - tops[i]);
+    const lineHeightPx = Math.max(1, clampPx(gaps.length ? median(gaps) : fontSizePx * 1.2));
+    const x0 = Math.min(...block.map(l => l.x0)), y0 = Math.min(...block.map(l => l.y0));
+    const x1 = Math.max(...block.map(l => l.x1)), y1 = Math.max(...block.map(l => l.y1));
+    const prevBottom = index > 0 ? Math.max(...blocks[index - 1].map(l => l.y1)) : y0;
+    const layout = {
+      role: role(block, index, blocks.length, pageHeightPx, bodySizePx),
+      font: 'unknown', fontSizePx, weight: 400, italic: false, underline: false,
+      lineHeightPx, alignment: alignment(block, pageWidthPx),
+      marginTopPx: Math.max(0, clampPx(y0 - prevBottom)), marginBottomPx: 0,
+      indentPx: Math.max(0, clampPx(block[0].x0 - x0)),
+      page: Math.max(1, Math.min(10000, Math.round(page))),
+      xPx: clampPx(x0), yPx: clampPx(y0), widthPx: Math.max(0, clampPx(x1 - x0)), heightPx: Math.max(0, clampPx(y1 - y0)),
+    };
+    return validateLayout(layout);
+  });
+}
diff --git a/extension/tests/layout-from-ocr.test.js b/extension/tests/layout-from-ocr.test.js
new file mode 100644
index 0000000..7680e0a
--- /dev/null
+++ b/extension/tests/layout-from-ocr.test.js
@@ -0,0 +1,62 @@
+import test from 'node:test';
+import assert from 'node:assert/strict';
+import {layoutFromOcr} from '../layout-from-ocr.js';
+import {validateLayout} from '../layout-model.js';
+
+// Synthetic word boxes only. No real document, no personal text.
+const word = (x0, y0, x1, y1) => ({text: 'XXXX', bbox: {x0, y0, x1, y1}});
+const line = (y, x0, x1, h = 20) => ({words: [word(x0, y, x1, y + h)]});
+
+test('agrupa líneas en un bloque y estima tamaño e interlineado', () => {
+  const ocr = {lines: [line(100, 50, 400), line(130, 50, 410), line(160, 50, 390)]};
+  const [block] = layoutFromOcr(ocr, {pageWidthPx: 1000, pageHeightPx: 1400, page: 1});
+  assert.equal(block.fontSizePx, 20);
+  assert.equal(block.lineHeightPx, 30);
+  assert.equal(block.alignment, 'left');
+  assert.equal(block.font, 'unknown');
+  assert.equal(block.weight, 400);
+});
+
+test('detecta alineación derecha, centrada y justificada', () => {
+  const right = {lines: [line(100, 200, 400), line(130, 260, 400), line(160, 230, 400)]};
+  assert.equal(layoutFromOcr(right)[0].alignment, 'right');
+  const center = {lines: [line(100, 300, 500), line(130, 320, 480), line(160, 310, 490)]};
+  assert.equal(layoutFromOcr(center)[0].alignment, 'center');
+  const justify = {lines: [line(100, 100, 500), line(130, 100, 500), line(160, 100, 500)]};
+  assert.equal(layoutFromOcr(justify)[0].alignment, 'justify');
+});
+
+test('separa bloques por el salto vertical y marca encabezado/cuerpo/pie', () => {
+  const ocr = {lines: [
+    line(40, 100, 300, 30),        // header near top, larger
+    line(500, 50, 600), line(530, 50, 610), // body
+    line(1360, 50, 400, 14),       // footer near bottom, smaller
+  ]};
+  const blocks = layoutFromOcr(ocr, {pageWidthPx: 1000, pageHeightPx: 1400, page: 2});
+  assert.equal(blocks.length, 3);
+  assert.equal(blocks[0].role, 'header');
+  assert.equal(blocks[1].role, 'body');
+  assert.equal(blocks[2].role, 'footer');
+  assert.equal(blocks[0].page, 2);
+});
+
+test('acepta lista plana de palabras y produce layout válido', () => {
+  const ocr = {words: [word(50, 100, 150, 120), word(160, 100, 260, 120), word(50, 130, 150, 150)]};
+  const blocks = layoutFromOcr(ocr, {pageWidthPx: 800, pageHeightPx: 1000});
+  assert.ok(blocks.length >= 1);
+  for (const b of blocks) assert.doesNotThrow(() => validateLayout(b));
+});
+
+test('entrada vacía o inválida devuelve lista vacía, nunca lanza', () => {
+  assert.deepEqual(layoutFromOcr({}), []);
+  assert.deepEqual(layoutFromOcr({lines: []}), []);
+  assert.deepEqual(layoutFromOcr({words: [{text: 'x', bbox: {x0: 5, y0: 5, x1: 1, y1: 1}}]}), []);
+});
+
+test('todo bloque emitido pasa validateLayout (sin contenido personal)', () => {
+  const ocr = {lines: Array.from({length: 6}, (_, i) => line(100 + i * 25, 60, 520))};
+  for (const b of layoutFromOcr(ocr, {pageWidthPx: 1000, pageHeightPx: 1400})) {
+    assert.doesNotThrow(() => validateLayout(b));
+    assert.equal(Object.prototype.hasOwnProperty.call(b, 'text'), false);
+  }
+});
